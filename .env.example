# CoinGecko API key (Analyst plan or above — onchain wallet + megafilter endpoints are paid-tier).
# Get one: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your-key-here

# Optional settings. Remove the leading # on a line to change it; the defaults are shown.

# Which chain to report on: any network id from /onchain/networks (e.g. base, solana)
# CG_NETWORK=robinhood

# Chain name as shown in the report
# CG_NETWORK_LABEL=Robinhood Chain

# Block explorer used for token and wallet links
# CG_EXPLORER=https://robin.etherscan.io

# Parallel API requests. Lower to 2 if you see "429 rate limited" often.
# CG_CONCURRENCY=4

# Your X handle, shown in the report footer and added to CoinGecko links
# X_HANDLE=yourhandle

# Headline filter for page 1 (case-insensitive regex). A /news item is kept when its title matches this
# or when CoinGecko tags it with a coin tracked on this chain. Default: robinhood|\bhood\b|robin\s?chain
# CG_NEWS_MATCH=base chain|\bbase\b
